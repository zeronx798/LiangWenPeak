<Window
    x:Class="LiangWenPeak.ApiSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="API Key 功能">

    <Grid
        x:Name="RootGrid"
        Padding="20,16,20,18"
        Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            x:Name="SettingsScroller"
            AutomationProperties.Name="API 设置滚动区域"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,16,0" Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="启用 API Key 功能" />
                    <ToggleSwitch
                        x:Name="ApiFeatureToggle"
                        Grid.Column="1"
                        AutomationProperties.Name="启用 API Key 功能"
                        OffContent="关"
                        OnContent="开" />
                </Grid>

                <TextBlock
                    FontSize="11"
                    Foreground="{StaticResource TertiaryTextBrush}"
                    Text="关闭后停止余额获取和历史采样；已保存的 API Key、配置与历史不会删除。"
                    TextWrapping="Wrap" />

                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="API" />
                <Border Height="1" Background="{StaticResource DividerBrush}" />

                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="API Key" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox
                        x:Name="ApiKeyBox"
                        AutomationProperties.Name="API Key"
                        PasswordChanged="OnApiKeyPasswordChanged"
                        PasswordRevealMode="Peek" />
                    <Button
                        x:Name="ClearApiKeyButton"
                        Grid.Column="1"
                        MinWidth="58"
                        Click="OnClearApiKeyClick"
                        Content="清除" />
                </Grid>

                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="显示币种" />
                <ComboBox
                    x:Name="CurrencyBox"
                    AutomationProperties.Name="显示币种"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnCurrencyChanged" />

                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="余额自动刷新" />
                <ComboBox
                    x:Name="RefreshIntervalBox"
                    AutomationProperties.Name="余额自动刷新"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnRefreshIntervalChanged" />

                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="余额预测" />
                <Border Height="1" Background="{StaticResource DividerBrush}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="显示余额预测" />
                    <ToggleSwitch
                        x:Name="ForecastEnabledBox"
                        Grid.Column="1"
                        AutomationProperties.Name="显示余额预测"
                        OffContent="关"
                        OnContent="开" />
                </Grid>

                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="余额预警" />
                <TextBox
                    x:Name="WarningBalanceBox"
                    AutomationProperties.Name="余额预警"
                    InputScope="Number"
                    PlaceholderText="0.00" />

                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="消耗速率窗口" />
                <ComboBox
                    x:Name="RateWindowBox"
                    AutomationProperties.Name="消耗速率窗口"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnRateWindowChanged" />

                <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="预测算法" />
                <ComboBox
                    x:Name="AlgorithmBox"
                    AutomationProperties.Name="预测算法"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnAlgorithmChanged" />

                <TextBlock
                    x:Name="SettingsStatusText"
                    MinHeight="16"
                    FontSize="11"
                    Foreground="{StaticResource TertiaryTextBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,14,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="ResetStatisticsButton"
                HorizontalAlignment="Left"
                AutomationProperties.Name="重新开始统计"
                Click="OnResetStatisticsClick"
                Content="重新开始统计" />
            <Button
                x:Name="SaveButton"
                Grid.Column="1"
                MinWidth="64"
                AutomationProperties.Name="保存设置"
                Click="OnSaveClick"
                Content="保存"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                x:Name="CancelButton"
                Grid.Column="2"
                MinWidth="64"
                AutomationProperties.Name="取消设置"
                Click="OnCancelClick"
                Content="取消" />
        </Grid>
    </Grid>
</Window>
